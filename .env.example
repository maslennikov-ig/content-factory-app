# Content Factory configuration example.
# Every value below is a placeholder. Never commit a real secret.

# === Required Settings
DATABASE_URL="postgresql://cf-dev:cf-dev-pwd@localhost:5432/cf-dev-db"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"
# Stable, instance-specific HMAC key (at least 32 bytes) for trusted growth-event
# receipts. Generate it independently from JWT_SECRET and keep it across deploys.
PUBLIC_GROWTH_DEDUPE_KEY=""

# === This needs to be exactly the URL you are accessing Content Factory on
FRONTEND_URL="http://localhost:4200"
# Cookies are scoped to the host of FRONTEND_URL. Set this only if one session
# must span several subdomains; ".example.com" gives it to every site there.
#AUTH_COOKIE_DOMAIN=""
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"

# === Optional: own error collector
# Collection stays off unless both DSN and its exact http(s) origin are set.
# Server values cover backend, orchestrator, Next server and Next edge.
#CONTENT_FACTORY_ERROR_DSN="https://public-project-key@errors.example.invalid/1"
#CONTENT_FACTORY_ERROR_ORIGIN="https://errors.example.invalid"
#CONTENT_FACTORY_RELEASE="local"

## Remember to set your public internet IP address in the allow-list for the API token.
##
## Cloudflare is currently required to save things like social media avatars for accounts.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
CLOUDFLARE_BUCKET_URL="https://your-bucket-url.r2.cloudflarestorage.com/"
CLOUDFLARE_REGION="auto"

# === Common optional Settings

## Configure a provider-specific key in the deployment environment if email
## approval is enabled. Never commit a key, even as an example.
## If this variable is commented out, users are activated automatically.
#RESEND_API_KEY=""
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
#DISABLE_REGISTRATION=false
# Registration stays open, but a new account cannot be used until an
# administrator approves it on /admin/users. Only the string "true" enables it.
#CONTENT_FACTORY_REQUIRE_APPROVAL=true

# Where will social media icons be saved - local or cloudflare.
STORAGE_PROVIDER="local"

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
# Use an ABSOLUTE path: frontend, backend and orchestrator each start from their
# own working directory, so a relative path makes them read three different
# folders and uploaded media disappears between writing and serving it.
#UPLOAD_DIRECTORY=""

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Social Media API Settings
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Self-hosted newsletter. Beehiiv is intentionally unsupported: subscriber
# addresses must not leave this deployment.
#
# Empty on purpose: any one of these five values selects the Listmonk provider,
# so a filled address in a copied development environment would make every
# registration with the box ticked fail against a container nobody started. Set
# them together, or leave them all empty and nothing is forwarded. The domain is
# the internal base URL of the newsletter service, for example
# http://cf-listmonk:9000.
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
LISTMONK_LIST_UUID=""
LISTMONK_DB_USER="listmonk"
LISTMONK_DB_PASSWORD=""
LISTMONK_DB_NAME="listmonk"
LISTMONK_ADMIN_USER=""
LISTMONK_ADMIN_PASSWORD=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# Telegram publishing uses one bot for every channel of this instance. Create
# it with @BotFather, then add it as an administrator of each channel you want
# to publish to. TELEGRAM_BOT_NAME is the username without `@`.
TELEGRAM_TOKEN=""
TELEGRAM_BOT_NAME=""
# Optional destination for private messages sent to this bot. Use the owner's
# Telegram chat id. Without it messages remain in the database outbox and the
# shared update consumer keeps running; no message text or attachment is stored.
TELEGRAM_SUPPORT_OWNER_CHAT_ID=""

# Telegram sign-in is a separate OpenID Connect client from BotFather's Login
# Widget settings. The button stays hidden unless both values are configured.
# Register the exact callback: ${FRONTEND_URL}/auth?provider=TELEGRAM
TELEGRAM_CLIENT_ID=""
TELEGRAM_CLIENT_SECRET=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# === Content Factory product surface
# Terms and privacy default to the pages this product serves itself, /terms and
# /privacy, so the registration notice always has somewhere to point. Set these
# only to override them with documents you host elsewhere. The documentation
# link has no built-in page and stays hidden until you publish one.
NEXT_PUBLIC_TERMS_URL=""
NEXT_PUBLIC_PRIVACY_URL=""
NEXT_PUBLIC_DOCS_URL=""

# Google sign-in is offered only when YOUTUBE_CLIENT_ID/SECRET are configured.

# Where agency review requests are sent; falls back to EMAIL_FROM_ADDRESS.
AGENCY_REVIEW_EMAIL=""

# Port for the orchestrator health endpoint (/health/status). Defaults to 3002;
# override it when something else on the host already holds that port.
#ORCHESTRATOR_PORT="3002"

# === Language model provider
# One key unlocks the editor copilot, image generation, the chat agent, the
# post generator and autopost rewriting.
#
# CopilotKit reports runtime metadata to its own Segment endpoint unless this
# is set. It carries no post content, but it is on by default in the library.
COPILOTKIT_TELEMETRY_DISABLED="true"
#
# Server-managed credentials used only when a workspace explicitly runs in
# included mode. Empty values keep that capability closed. Workspace-owned
# generation and search keys are entered in Settings and encrypted in the DB.
AI_INCLUDED_API_KEY=""
AI_INCLUDED_SEARCH_API_KEY=""
#AI_PROVIDER="openai"           # openai | openrouter

# Model overrides. Defaults follow the provider: OpenAI uses gpt-4.1 and
# chatgpt-image-latest, OpenRouter uses openai/gpt-5.6-luna and
# openai/gpt-5-image. OpenRouter model ids are namespaced.
#AI_TEXT_MODEL=""
#AI_IMAGE_MODEL=""
# Point the OpenAI-compatible clients at any other gateway.
#AI_BASE_URL=""

# Misc Settings
# Where the support button sends people: a telegram chat, a mailto:, a page —
# whatever channel this instance actually answers on. Unset means no button,
# which is the honest default until one exists.
NEXT_PUBLIC_SUPPORT_URL=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit
# Publishes the Swagger UI at /docs and the specification at /docs-json and
# /docs-yaml — behind nginx, /api/docs. Nobody has to sign in to read them, and
# what they list is every route the backend answers, admin and oauth included.
# Leave it off unless someone is actually writing against the API. Only the
# string "true" enables it.
#CONTENT_FACTORY_SWAGGER_ENABLED=true

# When connecting providers that take a self-hosted URL (WordPress, Mastodon,
# Lemmy, Listmonk, Bluesky PDS, etc.) Content Factory fetches that URL
# server-side and blocks requests that resolve to private/internal/loopback/
# link-local IPs to prevent SSRF. Set to true ONLY if your instance must reach
# those services on a trusted private network (e.g. same Docker network or VPC).
# DISABLE_SSRF_PROTECTION=false

# Payment settings
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now
NEXT_PUBLIC_CONTENT_FACTORY_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_CONTENT_FACTORY_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
CONTENT_FACTORY_GENERIC_OAUTH="false"
CONTENT_FACTORY_OAUTH_URL="https://auth.example.com"
CONTENT_FACTORY_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
CONTENT_FACTORY_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
CONTENT_FACTORY_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
CONTENT_FACTORY_OAUTH_CLIENT_ID=""
CONTENT_FACTORY_OAUTH_CLIENT_SECRET=""
# CONTENT_FACTORY_OAUTH_SCOPE="openid profile email" # default values

# Short Link Service Settings
# DUB_TOKEN="" # Your self-hosted Dub API token
# DUB_API_ENDPOINT="https://api.dub.co" # Your self-hosted Dub API endpoint
# DUB_SHORT_LINK_DOMAIN="dub.sh" # Your self-hosted Dub domain

# SHORT_IO_SECRET_KEY="" # Your Short.io API secret key

# KUTT_API_KEY="" # Your Kutt.it API key
# KUTT_API_ENDPOINT="https://kutt.it/api/v2" # Your self-hosted Kutt API endpoint
# KUTT_SHORT_LINK_DOMAIN="kutt.it" # Your self-hosted Kutt domain

# LINK_DRIP_API_KEY="" # Your LinkDrip API key
# LINK_DRIP_API_ENDPOINT="https://api.linkdrip.com/v1/" # Your self-hosted LinkDrip API endpoint
# LINK_DRIP_SHORT_LINK_DOMAIN="dripl.ink" # Your self-hosted LinkDrip domain
