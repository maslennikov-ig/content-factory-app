# Runtime environment for cf-app. Copy this file to `app.env` beside the
# production Compose file. Database-owner and Listmonk-owner credentials do not
# belong here; Compose reads those from its separate `.env` file.
# Generate JWT_SECRET on the host, for example with `openssl rand -base64 48`.

# These passwords match PRODUCT_RUNTIME_PASSWORD and MASTRA_RUNTIME_PASSWORD
# in the separate Compose `.env`. The application never receives the owner
# credential. Mastra's runtime connection has initialization disabled; its DDL
# is applied separately by the owner-run migration.
DATABASE_URL="postgresql://contentfactory_runtime:generate-on-the-host@cf-postgres:5432/contentfactory"
MASTRA_DATABASE_URL="postgresql://contentfactory_mastra_runtime:generate-on-the-host@cf-postgres:5432/contentfactory_mastra"
REDIS_URL="redis://cf-redis:6379"
JWT_SECRET="generate-on-the-host"
# Required stable, independent HMAC key with at least 32 bytes for trusted
# growth-event receipts. Keep it across deploys; do not reuse JWT_SECRET or
# any database, provider, webhook, or encryption secret.
PUBLIC_GROWTH_DEDUPE_KEY=""

FRONTEND_URL="https://factory.aidevteam.ru"
MAIN_URL="https://factory.aidevteam.ru"
NEXT_PUBLIC_BACKEND_URL="https://factory.aidevteam.ru/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
#AUTH_COOKIE_DOMAIN=""

TEMPORAL_ADDRESS="cf-temporal:7233"
TEMPORAL_NAMESPACE="default"
IS_GENERAL="true"
DISABLE_REGISTRATION="false"
CONTENT_FACTORY_REQUIRE_APPROVAL="true"
#EXCLUDE_QUEUE=""

STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads"
API_LIMIT="30"
NX_ADD_PLUGINS="false"
COPILOTKIT_TELEMETRY_DISABLED="true"
#CONTENT_FACTORY_SWAGGER_ENABLED="true"

# The newsletter, filled in at step 6 of docs/operations/newsletter.md and not
# before. All five stay empty until then: one filled value is enough to select
# the Listmonk provider, and a half-configured provider fails every registration
# with the box ticked instead of quietly forwarding nothing.
#
# The address must be an internal plain-HTTP base URL with no credentials and no
# path — `http://cf-listmonk:9000` for this Compose file. The writer must only be
# allowed to create subscribers in the target list.
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
LISTMONK_LIST_UUID=""

# Optional application integrations belong here when enabled.
#
# Mail delivery is switched by EMAIL_PROVIDER and by nothing else: "resend",
# "nodemailer", or off. A key without the switch sends nothing, and so does a
# provider without both EMAIL_FROM_* values. Password sign-in cannot be added
# at all while this is off, because the address is proved by a link in a mail.
# See docs/operations/configuration.md, "Доставка почты".
#EMAIL_PROVIDER=""
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
# EMAIL_PROVIDER="resend"
#RESEND_API_KEY=""
# EMAIL_PROVIDER="nodemailer"
#EMAIL_HOST=""
#EMAIL_PORT=""
#EMAIL_SECURE=""
#EMAIL_USER=""
#EMAIL_PASS=""
#TELEGRAM_CLIENT_ID=""
#TELEGRAM_CLIENT_SECRET=""
#TELEGRAM_TOKEN=""
#TELEGRAM_BOT_NAME=""
# Owner chat that receives private bot messages through the durable relay.
# Empty keeps them queued and emits an operator warning without stopping polling.
#TELEGRAM_SUPPORT_OWNER_CHAT_ID=""
# Server-managed credentials used only by workspaces in explicit included
# mode. Empty values keep included generation and search fail-closed.
AI_INCLUDED_API_KEY=""
AI_INCLUDED_SEARCH_API_KEY=""
#AI_PROVIDER=""
#AI_TEXT_MODEL=""
#AI_IMAGE_MODEL=""
#AI_BASE_URL=""
#NEXT_PUBLIC_SUPPORT_URL=""

# === Optional: own error collector, read by backend, orchestrator, the Next
# server and the Next edge runtime. Unset until the separately authorized
# GlitchTip deployment exists; DSN and origin must share the exact scheme, host
# and port or collection stays off. See docs/operations/error-collection.md.
#CONTENT_FACTORY_ERROR_DSN="https://public-project-key@errors.example.invalid/1"
#CONTENT_FACTORY_ERROR_ORIGIN="https://errors.example.invalid"
#CONTENT_FACTORY_RELEASE="replace-with-image-commit"
