# Template for the production `.env` that sits next to docker-compose.yaml on
# the host. Every value here is a placeholder. Generate the real secrets on the
# host, never in a chat, a document, a command argument or a commit.
#
#   POSTGRES_PASSWORD="$(openssl rand -base64 32 | tr -d '/+=')"

# === Image to run. Set by the deploy step to the tag that was loaded.
CF_IMAGE="content-factory-next:latest"

# === PostgreSQL owner used by the Compose-managed database service.
POSTGRES_USER="contentfactory"
POSTGRES_PASSWORD="generate-on-the-host"
POSTGRES_DB="contentfactory"

# === Database roles used by the application. The owner above is reserved for
# bootstrap, migrations, backup/restore and Temporal. These runtime roles own
# neither a database nor a schema and cannot create database objects.
PRODUCT_RUNTIME_USER="contentfactory_runtime"
PRODUCT_RUNTIME_PASSWORD="generate-on-the-host"
MASTRA_DATABASE_NAME="contentfactory_mastra"
MASTRA_RUNTIME_USER="contentfactory_mastra_runtime"
MASTRA_RUNTIME_PASSWORD="generate-on-the-host"

# === Self-hosted newsletter
# Only DB/admin values belong in the Compose interpolation file. The
# application-facing domain, list identity and least-privilege writer token
# live in the separate app.env file.
LISTMONK_DB_USER="listmonk"
LISTMONK_DB_PASSWORD="generate-on-the-host"
LISTMONK_DB_NAME="listmonk"
LISTMONK_ADMIN_USER="owner-generated-name"
LISTMONK_ADMIN_PASSWORD="generate-on-the-host"

# === Optional: own error collector. Leave all three unset until the separately
# authorized GlitchTip deployment exists. DSN and origin must share the exact
# scheme, host and port or collection stays off. These are application values:
# the running trio belongs in `app.env`, which the container reads, and this
# block stays here only so the owner sees the three names in one place.
#CONTENT_FACTORY_ERROR_DSN="https://public-project-key@errors.example.invalid/1"
#CONTENT_FACTORY_ERROR_ORIGIN="https://errors.example.invalid"
#CONTENT_FACTORY_RELEASE="replace-with-image-commit"
