# Template for the separate GlitchTip host. Every value is a placeholder.
# Copy this file to `.env` on that host and replace every `replace-*` value
# there. Never commit the resulting file.

GLITCHTIP_POSTGRES_USER="glitchtip"
GLITCHTIP_POSTGRES_PASSWORD="replace-with-generated-secret"
GLITCHTIP_POSTGRES_DB="glitchtip"

GLITCHTIP_SECRET_KEY="replace-with-generated-secret"
GLITCHTIP_DOMAIN="https://replace-with-collector-domain.invalid"
GLITCHTIP_ALLOWED_HOSTS="replace-with-collector-domain.invalid"
GLITCHTIP_DEFAULT_FROM_EMAIL="errors@replace-with-collector-domain.invalid"

# The collector is reachable only from a reverse proxy on the same host.
GLITCHTIP_LISTEN_PORT="8000"
