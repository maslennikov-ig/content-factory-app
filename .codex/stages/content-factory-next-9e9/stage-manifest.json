  "scope_snapshot": {
    "source_kind": "beads",
    "source_id": "content-factory-next-9e9",
    "source_digest": "14404b8cbfca6de062607c6dc6d9e0653499718bb39878ba00e28006909a1a41",
    "criteria": [
      {
        "criterion_id": "AC-0",
        "text": "Исследовательские решения приняты до реализации; дочерние задачи имеют проверяемые границы и зависимости; готовые функции подключены к пользовательским сценариям без неподтвержденных live-операций, секретов, платных вызовов или публикации.",
        "text_digest": "b6d69ff65d596aed4dc879a44f16c61c528750b7277e227c7cface51ea35adc7"
      },
      {
        "criterion_id": "AC-1",
        "text": "Есть доказательная матрица keep/adapt/reject со ссылками на исходные файлы, рисками, отсутствующими зависимостями и рекомендуемой последовательностью; до отдельного решения код не копируется и live-операции не запускаются.",
        "text_digest": "e0f818284543aa7383579fc5456069e8e64ae8720ff7ae16a24c436b9329fc85"
      },
      {
        "criterion_id": "AC-2",
        "text": "До реализации согласованы пользовательский путь, модель данных, tenancy и права, версия профиля, поведение при неполных данных, стоимость модельных вызовов, миграция и набор приемочных тестов; материальные продуктовые развилки вынесены на обсуждение владельцу.",
        "text_digest": "61ed5ab7aab1ec7bd77f57ff679c31ffd9552c84fa21b230328cd3090f65ac9a"
      },
      {
        "criterion_id": "AC-3",
        "text": "Пользователь создаёт, проверяет, редактирует и выбирает версию голоса; каждый подключенный сценарий показывает, какая версия применена; стиль и запреты проверяются тестами; отсутствие профиля имеет безопасный понятный fallback.",
        "text_digest": "0507a4ea6d00b6e64af27b231eb6f14ea3b517779d81c18bf35fa0dd5a1f8849"
      },
      {
        "criterion_id": "AC-4",
        "text": "Есть согласованный data-flow и модель данных, матрица типов источников, безопасные дефолты, lifecycle и ошибки, правила происхождения и цитирования, план миграции текущих AutoPost и researchSources и точные приемочные проверки; public scraping по умолчанию выключен.",
        "text_digest": "55fa6a1a0aa90a69a3f16d72870226876be13f41519e9a20b3b23148587aa217"
      },
      {
        "criterion_id": "AC-5",
        "text": "Пользователь добавляет разрешённый URL или RSS, видит состояние и свежесть, получает прослеживаемый черновик с источником; небезопасные адреса, редиректы, дубликаты и запрещённые операции закрыты тестами; live-публикация не выполняется.",
        "text_digest": "bae3b39a274a0116f9fa73dd763d843c89f939d2f6e31226986305e44f05209d"
      },
      {
        "criterion_id": "AC-6",
        "text": "Определены модель факта и доказательства, правила обновления и конфликтов, поиск и цитирование, удаление и tenant isolation, границы модельной обработки, UX просмотра источника и проверяемый план внедрения.",
        "text_digest": "78080688cce359fe92a297085c56181cbcca9ec84525f98b58022e58bdeef4fb"
      },
      {
        "criterion_id": "AC-7",
        "text": "Все четыре сценария используют общий проверяемый контракт контекста, показывают источники и свежесть, не делают неподтверждённых текущих утверждений при недоступном исследовании и сохраняют происхождение результата.",
        "text_digest": "4287c93f6f3e51a49fa29a1399461130ae82c4fdb7debc41cca1d26a21ab1d04"
      }
    ]
  },
