  "findDepthBody": "\n  let depth = 0;\n  let elementer = element;\n  while (elementer.parentNode) {\n    depth++;\n    // @ts-ignore\n    elementer = elementer.parentNode;\n  }\n  return depth;",
  "extractBody": "const dom = new JSDOM(load);\n\n    // only element that has a title\n    const allTitles = Array.from(dom.window.document.querySelectorAll('*'))\n      .filter((f) => {\n        return (\n          f.querySelector('h1') ||\n          f.querySelector('h2') ||\n          f.querySelector('h3') ||\n          f.querySelector('h4') ||\n          f.querySelector('h5') ||\n          f.querySelector('h6')\n        );\n      })\n      .reverse();\n\n    const findTheOneWithMostTitles = allTitles.reduce(\n      (all, current) => {\n        const depth = findDepth(current);\n        const calculate = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'].reduce(\n          (total, tag) => {\n            if (current.querySelector(tag)) {\n              return total + 1;\n            }\n            return total;\n          },\n          0\n        );\n\n        if (calculate > all.total) {\n          return { total: calculate, depth, element: current };\n        }\n\n        if (depth > all.depth) {\n          return { total: calculate, depth, element: current };\n        }\n\n        return all;\n      },\n      { total: 0, depth: 0, element: null }\n    );\n\n    return findTheOneWithMostTitles?.element?.textContent\n      ?.replace(/\\n/g, ' ')\n      .replace(/ {2,}/g, ' ');",
  "autopostBody": "\n    try {\n      const loadDom = new JSDOM(\n        html\n      );\n      loadDom.window.document\n        .querySelectorAll('script')\n        .forEach((s) => s.remove());\n      loadDom.window.document\n        .querySelectorAll('style')\n        .forEach((s) => s.remove());\n      // remove all html, script and styles\n      return striptags(loadDom.window.document.body.innerHTML);\n    } catch (err) {\n      return '';\n    }",
