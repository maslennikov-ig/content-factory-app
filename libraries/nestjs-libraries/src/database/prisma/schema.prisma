/// A finished text that exists apart from any post.
///
/// The product had no such thing: a post was the only unit, so reusing one
/// meant copying it. A piece is written once and recut per platform, and the
/// recut posts point back at it — which is what makes "where did this come
/// from" answerable and "publish this elsewhere" a single action.
model ContentPiece {
  id                       String                      @id @default(uuid())
  organizationId           String
  title                    String
  body                     String
  language                 String                      @default("ru")
  tags                     Json?
  /// Which voice version wrote it, so a later recut can say whether the voice
  /// has moved on since.
  brandProfileVersionId    String?
  contentContextSnapshotId String?
  archivedAt               DateTime?
  createdByUserId          String
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandProfileVersion      ProjectBrandProfileVersion? @relation(fields: [organizationId, brandProfileVersionId], references: [organizationId, id])
  snapshot                 ContentContextSnapshot?     @relation(fields: [organizationId, contentContextSnapshotId], references: [organizationId, id])
  derivations              ContentDerivation[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@index([organizationId, brandProfileVersionId])
}

/// One post that came out of one piece, and the platform it was cut for.
///
/// Delivery is not this table's business: it records provenance, and the post
/// it points at is published by `PostsService` and the providers like any
/// other. `docs/product/migration-map.md` makes that a rule — a new entity
/// talking to a platform directly is the thing it forbids.
model ContentDerivation {
  id                    String                      @id @default(uuid())
  organizationId        String
  contentPieceId        String
  postId                String?
  integrationId         String?
  /// The platform this cut was made for, e.g. `telegram`, `vk`, `newsletter`.
  platform              String
  format                String
  brandProfileVersionId String?
  /// DRAFT | QUEUED | PUBLISHED — mirrored from the post for the library
  /// table, so listing a piece does not join every post it produced.
  state                 String                      @default("DRAFT")
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  piece                 ContentPiece                @relation(fields: [organizationId, contentPieceId], references: [organizationId, id], onDelete: Cascade)
  post                  Post?                       @relation(fields: [organizationId, postId], references: [organizationId, id])
  brandProfileVersion   ProjectBrandProfileVersion? @relation(fields: [organizationId, brandProfileVersionId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, contentPieceId])
  @@index([organizationId, platform, state])
}

/// One text a workspace brought in as an example of how it writes.
///
/// Stored apart from the source it came from, even when it came from the
/// registry. Otherwise deleting a source silently pulls the ground out from
/// under an already-computed profile, and a reference corpus could not be
/// given a retention date independent of the evidence it sits beside.
model BrandVoiceSample {
  id             String               @id @default(uuid())
  organizationId String
  /// OWN_POST | TELEGRAM_EXPORT | PASTE | FILE | SOURCE_SNAPSHOT
  origin         String
  /// OWN_VOICE | STYLE_REFERENCE. A reference sample never becomes evidence,
  /// never enters a fact and is never quoted — see ADR-0011.
  usagePurpose   String               @default("OWN_VOICE")
  title          String
  /// The cleaned text. Secrets are removed before this column is written, not
  /// before it is read: a credential that reached the database has leaked.
  text           String
  /// sha256 of the normalised text. Dedup key: the same post arriving by two
  /// paths must not pull every corridor towards itself.
  contentHash    String
  charCount      Int
  wordCount      Int
  language       String               @default("ru")
  /// OWN_CONTENT | RIGHTS_CONFIRMED | RIGHTS_PENDING
  rightsState    String               @default("OWN_CONTENT")
  /// Mandatory for STYLE_REFERENCE: the raw text lives until this date and is
  /// then erased, leaving only the derived measurement.
  retentionUntil DateTime?
  sourceId       String?
  postId         String?
  /// Message id, file name or URL, kept so a person can tell two apart.
  externalRef    String?
  /// Whose text this is — which avatar was measured from it.
  ///
  /// Added 2026-08-26. Until then the corpus belonged to the workspace, so a
  /// space holding two avatars measured both of them over everybody's texts:
  /// three authors in one space produced one averaged author, and the avatars
  /// came out identical. `ProjectBrandProfile` already said each avatar needs
  /// its own corpus; this column is what makes that true.
  ///
  /// `NULL` means a text that arrived before its avatar existed — the intake
  /// screens work before any profile does — and the space's default avatar
  /// reads those as its own. That preserves the previous behaviour exactly for
  /// every corpus loaded until now, rather than approximating it.
  avatarId       String?
  /// What was taken out on the way in, by kind and count. Never the value.
  redactions     Json?
  /// Soft delete plus hard erasure of `text`, so a deletion is visible in the
  /// corpus history without the words surviving it.
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         ContentSource?       @relation(fields: [organizationId, sourceId], references: [organizationId, id])
  post           Post?                @relation(fields: [organizationId, postId], references: [organizationId, id])
  /// `SetNull` and not `Cascade`: deleting an avatar must not erase an
  /// author's writing. The service hands the texts to the successor the same
  /// request names, and this is the floor under that — if it ever fails, the
  /// corpus becomes the default avatar's rather than disappearing.
  avatar         ProjectBrandProfile? @relation(fields: [avatarId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  /// Dedup is per avatar, not per workspace.
  ///
  /// It was `[organizationId, contentHash]` until 2026-08-26, which made the
  /// PERSON/BRAND pair the schema describes impossible to build: a person and
  /// their brand are measured from overlapping texts, and the second avatar's
  /// intake was refused as a duplicate of the first. Within one avatar the
  /// rule is unchanged and is the one that matters — the same post arriving by
  /// two paths still pulls no corridor towards itself.
  ///
  /// Rows with `avatarId IS NULL` are not covered, because Postgres treats
  /// NULLs as distinct. Those are only the pre-2026-08-26 corpora, whose
  /// duplicates were already refused by the old constraint.
  @@unique([organizationId, avatarId, contentHash])
  @@index([organizationId, usagePurpose, deletedAt])
  @@index([organizationId, avatarId, deletedAt])
  @@index([organizationId, origin])
  @@index([organizationId, retentionUntil])
}

/// A measured description of how an organization's own texts are written.
///
/// Produced by the deterministic analyser: no model call, no network, no key.
/// The two version columns are what make a row readable a year later —
/// `analyzerVersion` moves when a formula changes, `localePackVersion` when a
/// dictionary does, and a corridor nobody can reproduce is a number the
/// generator obeys for no stated reason.
model BrandVoiceMeasurement {
  id                String                       @id @default(uuid())
  organizationId    String
  profileVersionId  String?
  analyzerVersion   String
  localePackVersion String
  language          String                       @default("ru")
  sampleCount       Int
  charCount         Int                          @default(0)
  wordCount         Int                          @default(0)
  sentenceCount     Int                          @default(0)
  /// One entry per scale: value, corridor, how much it was counted on, and a
  /// real sentence with the sample code so a screen can show its working.
  metrics           Json
  /// The frequent words and punctuation habits the analysis screen lists.
  lexicon           Json?
  punctuation       Json?
  /// Which samples were held out, so the activation check is repeatable.
  corpusSplit       Json?
  holdoutResult     Json?
  /// Set when a sample it was computed from is deleted. The measurement is
  /// marked stale rather than recomputed: recomputing moves corridors, and
  /// with them what the generator may write, which is not a silent change.
  stale             Boolean                      @default(false)
  /// Whose texts were counted — which avatar this analysis is about.
  ///
  /// Added 2026-08-26 alongside `BrandVoiceSample.avatarId`, and for the same
  /// reason: `latestMeasurement` answered "the newest analysis in this space",
  /// so a second avatar's run became the first one's passport, corridors and
  /// scales. `NULL` predates avatars and belongs to the default one.
  avatarId          String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  avatar            ProjectBrandProfile?         @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  /// The version this run was activated into MOST RECENTLY, kept only so an
  /// older image reading this column still finds something. Which analysis
  /// explains a version is answered by `ProjectBrandProfileVersion.measurementId`
  /// and nothing reads this one — activating a second voice from one analysis
  /// moves it, which is exactly the reason the pointer changed sides.
  profileVersion    ProjectBrandProfileVersion?  @relation("MeasurementLastActivation", fields: [organizationId, profileVersionId], references: [organizationId, id])
  explainedVersions ProjectBrandProfileVersion[] @relation("VersionMeasurement")

  @@unique([organizationId, id])
  @@index([organizationId, profileVersionId])
  @@index([organizationId, avatarId, createdAt])
  @@index([organizationId, stale])
}

/// Что предложил продукт и что человек отправил вместо этого.
///
/// Порог похожести снимается на настоящих текстах других авторов системы —
/// единственном бесплатном отрицательном материале, который есть. Замер
/// 27.08.2026 показал границу этого материала: при трёх процентах пропущенных
/// чужих ЛЮДЕЙ порог пропускает 2%, 23% и 45% ГЕНЕРАЦИЙ. Текст, написанный
/// моделью под голос человека, прячется лучше, чем посторонний, и сузить это
/// может только материал того же рода — собственные черновики пространства.
///
/// Пара в одной строке, а не два ряда: отрицательным примером является именно
/// то, что автор ПЕРЕПИСАЛ, и положительным — то, чем он это заменил. Разложив
/// их по разным таблицам, эту связь пришлось бы восстанавливать по времени.
///
/// Собирается и меряется, но ни во что не подмешивается. Порядок строгий, и он
/// же граница осторожности: судить, помогает ли это, пока нечем, а «система
/// учится на ваших правках» без замера — обещание, а не свойство
/// (`content-factory-next-pl1.32`).
///
/// Срок хранения: пока живёт аватар. Удаление аватара удаляет и правки —
/// `Cascade` ниже и явное стирание в `VoiceService.deleteAvatar`, — потому что
/// это тексты про конкретного автора, и наследнику они не переходят. Удаление
/// аккаунта удаляет их вместе с организацией.
model BrandVoiceEdit {
  id               String              @id @default(uuid())
  organizationId   String
  /// Чей это голос. Обязателен, в отличие от `BrandVoiceSample.avatarId`:
  /// правка появляется только там, где голос уже собран, так что случая
  /// «пришло до того, как появился аватар» здесь не бывает.
  avatarId         String
  /// Версия голоса, которой написан черновик. Нужна, чтобы правки, снятые до
  /// смены голоса, не смешивались с правками после неё.
  profileVersionId String?
  postId           String?
  language         String              @default("ru")
  /// Текст, как его предложил продукт.
  proposedText     String
  /// Текст, как его отправил человек.
  sentText         String
  proposedChars    Int
  sentChars        Int
  /// sha256 нормализованной пары. Сохранение одного и того же черновика
  /// дважды — одна правка, а не две: иначе пересохранение поста удвоило бы
  /// вес одного наблюдения в будущем замере.
  pairHash         String
  /// Тронул ли человек текст вообще. Отправленный без единой правки черновик —
  /// тоже наблюдение, и притом ценное, поэтому строка пишется в обоих случаях.
  changed          Boolean
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// `Cascade`, а не `SetNull`: правка без автора не отрицательный пример, а
  /// два чужих друг другу текста.
  avatar           ProjectBrandProfile @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, avatarId, pairHash])
  @@index([organizationId, avatarId, deletedAt])
  @@index([organizationId, createdAt])
}

enum BrandProfileLifecycle {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  CANCELED
  COMPLETED
}

enum From {
  BUYER
  SELLER
}

enum State {
  QUEUE
  PUBLISHED
  ERROR
  DRAFT
}

// Editorial process stage of a post. Matches `CONTENT_WORKFLOW_TAG_KEYS` in
// `organizations/organization.repository.ts` one-to-one on purpose, so the
// pre-existing process tags on a post can be carried over to this field
// exactly — see `docs/operations/editorial-stage-schema-apply.sql`. This is
// NOT `State` above: `State` is delivery (did it publish), this is workflow
// (has it been reviewed). Do not add a fifth value or rename one without
// updating both the tag keys and the migration that reads them.
enum EditorialStage {
  PLAN
  DRAFT
  REVIEW
  SCHEDULED
}

enum SubscriptionTier {
  STANDARD
  PRO
  TEAM
  ULTIMATE
}

enum Period {
  MONTHLY
  YEARLY
}

enum Provider {
  LOCAL
  GITHUB
  GOOGLE
  FARCASTER
  WALLET
  GENERIC
  TELEGRAM
}

/// Roles inside one workspace. The ranking between them, and the fact that
/// `EDITOR` and `USER` are peers in authority, live in
/// `libraries/nestjs-libraries/src/user/organization.roles.ts`; what each one
/// may open is `docs/product/roles-matrix.md`.
enum Role {
  SUPERADMIN
  ADMIN
  /// Writes: posts, briefs, materials, the schedule. Does not connect
  /// channels and does not invite people.
  EDITOR
  USER
}

enum APPROVED_SUBMIT_FOR_ORDER {
  NO
  WAITING_CONFIRMATION
  YES
}

enum CreationMethod {
  UNKNOWN
  WEB
  MCP
  API
  AUTOPOST
  CLI
}

enum ShortLinkPreference {
  ASK
  YES
  NO
}

enum AnnouncementColor {
  INFO
  WARNING
  ERROR
}

enum AiUsageMode {
  included
  workspace_key
}

enum AiUsageStatus {
  admitted
  succeeded
  failed
}

model Announcement {
  id          String            @id @default(uuid())
  title       String
  description String
  color       AnnouncementColor @default(INFO)
  createdAt   DateTime          @default(now())
}

/// Which language-model provider an organization talks to, and with which key.
///
/// One row per organization. The key belongs to whoever pays for it, so it is
/// never shared: an organization without a row has no generation, and there is
/// no instance-wide fallback that would let one organization spend another's
/// budget. The value is stored encrypted and is never returned to a browser.
///
/// The environment still supplies the non-secret defaults (AI_PROVIDER,
/// AI_TEXT_MODEL, AI_IMAGE_MODEL, AI_BASE_URL) because those are operator
/// configuration rather than tenant data.
model AiProviderSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       @default("openai")
  usageMode      AiUsageMode  @default(workspace_key)
  apiKey         String?
  textModel      String?
  imageModel     String?
  searchEnabled  Boolean      @default(false)
  searchProvider String       @default("tavily")
  searchApiKey   String?
  searchTopic    String       @default("general")
  searchDepth    String       @default("advanced")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// Privacy-safe admission ledger. It records only which bounded product
/// operation was admitted; prompts, outputs, provider payloads and errors are
/// deliberately outside this model.
model AiUsageRecord {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Who asked for the operation, when a person did.
  ///
  /// The ledger counted an organization and nothing else, so «who spent this»
  /// had no answer at all — not a limit that could not be enforced, an amount
  /// that could not be shown. Nullable because not every operation has a
  /// person behind it: scheduled autoposting and other background work run
  /// with no session, and a null here says exactly that rather than blaming
  /// whoever set the schedule up.
  ///
  /// `SetNull` on delete, not `Cascade`: removing someone from the instance
  /// must not remove the organization's record of what was spent.
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  usageMode      AiUsageMode
  operation      String
  provider       String
  model          String?
  status         AiUsageStatus @default(admitted)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, usageMode, createdAt])
  @@index([organizationId, status, createdAt])
  /// Serves «what has this member spent this period»: the organization first,
  /// because no read of this ledger ever crosses one, then the member, then
  /// the period.
  @@index([organizationId, userId, createdAt])
  /// Serves the organization-unfiltered retention delete in
  /// `scripts/operations/cleanup-saas-retention.cjs`. The two composite indexes
  /// above lead with `organizationId` and cannot answer `createdAt < cutoff`.
  @@index([createdAt])
}

/// One feed or channel a workspace asked the product to read for it.
///
/// `content-factory-next-odb8.3`, «Откуда идеи» — the thing the owner wanted
/// from «Источники» from the start and never got
/// (`docs/product/content-section-map.md` §5). Deliberately its own model
/// rather than a second use of `ContentSource`: a subscription is read for a
/// reason `ContentSource` never had — a reason to write, not a fact to cite —
/// and its per-item lifecycle (`ContentLead`, accepted/dismissed and
/// remembered) has no counterpart in the source registry at all. What IS
/// reused, never duplicated, is the network and robots policy the registry
/// already carries — `network-policy.ts`, `source-access-policy.ts` and
/// `source-fetch.gateway.ts` — imported by `lead-feed.gateway.ts` rather than
/// rebuilt.
model ContentLeadSubscription {
  id                   String        @id @default(uuid())
  organizationId       String
  /// 'RSS' | 'URL'. A Telegram channel is named as a third kind in the
  /// product's own contract, but stays out of this column: it is switched off
  /// on every server today, and nothing here should invent a value an
  /// operator has not turned on anywhere (`SOURCE_TELEGRAM_INGEST`).
  kind                 String
  displayName          String
  canonicalUrl         String
  /// ACTIVE | PAUSED | ERRORED. A row stays ACTIVE through an ordinary failed
  /// check — the check retries on its own schedule — so ERRORED means the
  /// last attempt itself failed, not that the subscription stopped trying.
  state                String        @default("ACTIVE")
  /// How often the periodic check wakes up for this row. Owner-facing choices
  /// are coarser than the raw number (`Ideas.dc.html`: «раз в час» / «раз в
  /// сутки»); the minutes are what the workflow actually sleeps on.
  checkIntervalMinutes Int           @default(1440)
  lastCheckedAt        DateTime?
  lastErrorCode        String?
  /// The one case AutoPost is pulled in rather than duplicated
  /// (`content-lead.service.ts`): a subscription created from an existing
  /// `AutoPost` row shares its address and says so on the list, instead of a
  /// person configuring the same feed twice under two names that never learn
  /// about each other. Nothing about `AutoPost`'s own draft-per-hour workflow
  /// changes because this pointer exists.
  linkedAutoPostId     String?
  createdByUserId      String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedAutoPost       AutoPost?     @relation(fields: [organizationId, linkedAutoPostId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  leads                ContentLead[]

  @@unique([organizationId, id])
  @@unique([organizationId, kind, canonicalUrl])
  @@index([organizationId, state])
  @@index([organizationId, deletedAt])
  @@index([organizationId, linkedAutoPostId])
}

/// One item a subscription brought back: a reason to write, never a draft.
///
/// Dismissal is memory, not mood. `(organizationId, subscriptionId,
/// externalId)` is unique, and a check upserts new items on that key without
/// ever resetting an existing row's `status` back to `NEW` —
/// `ContentLeadRepository.upsertLeads` is the one place that matters and
/// `tests/content-lead-dismissal-guard.test.cjs` holds it in place. A lead the
/// workspace already said no to cannot come back merely because the feed
/// serves the same item again.
///
/// Accepting a lead does not create a `SourceEvidence` row or anything else
/// `ContentFact` can cite. That link — «повод → материал для ссылок» — is the
/// owner's open question in `content-factory-next-odb8.3` and is deliberately
/// left unbuilt, not merely unwired: see the task's report.
model ContentLead {
  id                String                  @id @default(uuid())
  organizationId    String
  subscriptionId    String
  /// The feed's own id for the item — guid, or its link when the feed gives
  /// no guid — mirroring how `source-parser.ts` already resolves feed-item
  /// identity for `ContentSource`, so a feed migrating between the two
  /// registries would keep the same identity rule.
  externalId        String
  title             String
  excerpt           String?
  sourceUrl         String
  publishedAt       DateTime?
  observedAt        DateTime                @default(now())
  /// Why this reader, not just what the item says (`Ideas.dc.html`'s card
  /// anatomy: тема → почему она ваша → фрагмент). Computed once at check time
  /// and kept in both product languages, the same way `content-brief.radar.ts`
  /// keeps a reason per language rather than translating one on read.
  reasonRu          String
  reasonEn          String
  /// NEW | DISMISSED | ACCEPTED.
  status            String                  @default("NEW")
  dismissedAt       DateTime?
  dismissedByUserId String?
  acceptedAt        DateTime?
  acceptedByUserId  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription      ContentLeadSubscription @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, subscriptionId, externalId])
  @@index([organizationId, status, observedAt])
  @@index([organizationId, subscriptionId, status])
}
