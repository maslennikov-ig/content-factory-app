  fromVersion    ProjectBrandProfileVersion? @relation("BrandAuditFromVersion", fields: [organizationId, fromVersionId], references: [organizationId, id])
  toVersion      ProjectBrandProfileVersion? @relation("BrandAuditToVersion", fields: [organizationId, toVersionId], references: [organizationId, id])

