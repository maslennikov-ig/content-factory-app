/// One avatar. A space may hold several, and one of them is the default.
///
/// `organizationId` was `@unique` until 2026-08-25, which made an avatar a
/// property of the workspace rather than a thing the workspace owns. The owner
/// asked to keep more than one — himself, a colleague, the brand — and each
/// needs its own corpus, its own print and its own portrait, because a print
/// averaged over two people describes neither.
model ProjectBrandProfile {
  id                String                       @id @default(uuid())
  organizationId    String
  /// What a person calls this avatar. Absent on profiles made before names
  /// existed; the screens fall back to the active version's label.
  name              String?
  /// A human being or a brand. The difference is who speaks and how noisy the
  /// print is, not two separate mechanisms — see `BrandPersonaV1`.
  kind              BrandPersonaKind             @default(PERSON)
  /// The one used when nothing else is chosen. Exactly one per space is the
  /// invariant, and it is held by the repository rather than by the database:
  /// a partial unique index would make the moment between clearing the old
  /// default and setting the new one illegal.
  isDefault         Boolean                      @default(false)
  activeVersionId   String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  deletedAt         DateTime?
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeVersion     ProjectBrandProfileVersion?  @relation("ActiveBrandProfileVersion", fields: [organizationId, activeVersionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  versions          ProjectBrandProfileVersion[] @relation("ProfileVersions")
  auditEvents       BrandProfileAuditEvent[]
  /// The texts this avatar was measured from, and the analyses of them. Added
  /// 2026-08-26: the sentence above promised each avatar its own corpus and
  /// its own print, and both stayed properties of the workspace — so a second
  /// author in the same space averaged into the first one's print and then
  /// took over their passport.
  voiceSamples      BrandVoiceSample[]
  voiceMeasurements BrandVoiceMeasurement[]
  /// Правки автора в черновиках этого аватара. Живут, пока живёт он.
  voiceEdits        BrandVoiceEdit[]

  @@unique([organizationId, id])
  @@index([organizationId, deletedAt])
  @@index([organizationId, activeVersionId])
  @@index([organizationId, isDefault])
}

enum BrandPersonaKind {
  PERSON
  BRAND
}

model ProjectBrandProfileVersion {
  id                String                       @id @default(uuid())
  organizationId    String
  profileId         String
  versionNumber     Int
  parentVersionId   String?
  schemaVersion     Int                          @default(1)
  lifecycle         BrandProfileLifecycle        @default(DRAFT)
  label             String?
  content           Json
  contentDigest     String
  /// The analysis whose numbers explain THIS version's voice fields.
  ///
  /// The pointer sits here rather than on the measurement because that is the
  /// real cardinality: one version is explained by at most one analysis, while
  /// one analysis becomes as many versions as somebody activates from it —
  /// accepting three fields, then four, then editing one. A single column on
  /// the measurement could only ever hold the last of those, so activating a
  /// second voice from one run left the first reading as never analysed and
  /// took its corridors away.
  measurementId     String?
  revision          Int                          @default(1)
  createdByUserId   String
  updatedByUserId   String
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile           ProjectBrandProfile          @relation("ProfileVersions", fields: [organizationId, profileId], references: [organizationId, id])
  parentVersion     ProjectBrandProfileVersion?  @relation("BrandProfileVersionParent", fields: [organizationId, parentVersionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  childVersions     ProjectBrandProfileVersion[] @relation("BrandProfileVersionParent")
  activeForProfiles ProjectBrandProfile[]        @relation("ActiveBrandProfileVersion")
  auditEvents       BrandProfileAuditEvent[]     @relation("BrandAuditVersion")
  auditEventsFrom   BrandProfileAuditEvent[]     @relation("BrandAuditFromVersion")
  auditEventsTo     BrandProfileAuditEvent[]     @relation("BrandAuditToVersion")
  posts             Post[]                       @relation("PostBrandProfileVersion")
  autoPosts         AutoPost[]
  contextSnapshots  ContentContextSnapshot[]
  outputContexts    ContentOutputContext[]
  voiceMeasurements BrandVoiceMeasurement[]      @relation("MeasurementLastActivation")
  measurement       BrandVoiceMeasurement?       @relation("VersionMeasurement", fields: [organizationId, measurementId], references: [organizationId, id])
  contentPieces     ContentPiece[]
  derivations       ContentDerivation[]

  @@unique([organizationId, id])
  @@unique([organizationId, profileId, versionNumber])
  @@index([organizationId, profileId, lifecycle])
  @@index([organizationId, contentDigest])
  @@index([organizationId, parentVersionId])
  @@index([organizationId, measurementId])
}

model BrandProfileAuditEvent {
